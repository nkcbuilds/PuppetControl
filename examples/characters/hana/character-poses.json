{
  "schemaVersion": 1,
  "id": "hana",
  "defaultPose": "neutral",
  "poseFamilies": [
    {
      "name": "neutral",
      "rigId": "hana-neutral-art",
      "head": "shared",
      "approved": true,
      "modelPath": "rigs/neutral.r2d.json"
    },
    {
      "name": "pointing",
      "rigId": "hana-pointing-art",
      "head": "shared",
      "approved": true,
      "modelPath": "rigs/pointing.r2d.json"
    },
    {
      "name": "arms-crossed",
      "rigId": "hana-crossed-art",
      "head": "shared",
      "approved": true,
      "modelPath": "rigs/arms-crossed.r2d.json"
    }
  ],
  "expressions": ["neutral", "happy", "confused", "annoyed"],
  "motions": [],
  "transitions": [
    { "kind": "cut", "from": "neutral", "to": "pointing" },
    { "kind": "cut", "from": "pointing", "to": "arms-crossed" },
    { "kind": "cut", "from": "arms-crossed", "to": "neutral" }
