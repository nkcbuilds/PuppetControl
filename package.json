{
  "name": "puppetcontrol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-first 2D character animation with reusable rigged pose families",
  "license": "MIT",
  "bin": {
    "puppetctl": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "rig:status": "node scripts/setup-rev2d.mjs --status --json",
    "rig:setup": "node scripts/setup-rev2d.mjs --install",
    "demo:preview": "tsx src/cli/index.ts scene preview examples/scenes/hana-preview.json",
    "demo:render": "tsx src/cli/index.ts scene render examples/scenes/hana-preview.json",
    "demo:poses": "node scripts/build-demo-poses.mjs",
    "demo:multipose": "tsx src/cli/index.ts scene render examples/scenes/hana-multipose.json",
    "demo:1080p": "tsx src/cli/index.ts scene render examples/scenes/hana-multipose-1080p.json",
    "demo:directed": "tsx src/cli/index.ts scene render examples/scenes/hana-directed-1080p.json",
    "demo:gesture:rig": "npm run demo:poses && node scripts/build-demo-gesture.mjs",
    "demo:gesture": "npm run demo:gesture:rig && tsx src/cli/index.ts scene render examples/scenes/hana-gesture-1080p.json",
    "demo:gesture-cycle": "npm run demo:gesture:rig && tsx src/cli/index.ts scene render examples/scenes/hana-gesture-cycle.json",
    "demo:benchmark": "npm run demo:gesture:rig && tsx src/cli/index.ts scene render examples/scenes/hana-45s-benchmark.json",
    "demo:avatar": "npm run build && node scripts/demo-avatar-import.mjs",
    "demo:first-video": "npm run build && node scripts/demo-first-video.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
